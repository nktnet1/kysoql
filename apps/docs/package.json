{
  "name": "docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm docs:api && vite dev",
    "build": "pnpm docs:api && vite build",
    "check": "biome check",
    "preview": "vite preview",
    "types:check": "tsc --noEmit",
    "check:content": "pnpm docs:api && node --test scripts/content.test.ts && node scripts/check-content.ts",
    "check:examples": "node scripts/check-examples.ts",
    "typecheck:source": "pnpm check:content && pnpm check:examples && pnpm types:check",
    "docs:api": "pnpm docs:api:core && pnpm docs:api:rest && pnpm docs:api:auth && pnpm docs:api:codegen && pnpm docs:api:jsforce",
    "docs:api:core": "typedoc --options ./typedoc/core.ts",
    "docs:api:rest": "typedoc --options ./typedoc/rest.ts",
    "docs:api:auth": "typedoc --options ./typedoc/auth.ts",
    "docs:api:codegen": "typedoc --options ./typedoc/codegen.ts",
    "docs:api:jsforce": "typedoc --options ./typedoc/jsforce.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.168.58",
    "cn": "^0.3.3",
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.13",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "seroval": "1.6.7"
  },
  "devDependencies": {
    "@kysoql/auth": "workspace:*",
    "@kysoql/codegen": "workspace:*",
    "@kysoql/core": "workspace:*",
    "@kysoql/jsforce": "workspace:*",
    "@kysoql/rest": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "srvx": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-frontmatter": "1.3.2",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "6.0.3",
    "vite": "^8.3.0"
  }
}
