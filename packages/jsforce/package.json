{
  "name": "@kysoql/jsforce",
  "version": "0.0.0",
  "description": "JSforce adapter for kysoql",
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@kysoql/core": "workspace:*",
    "jsforce": "3.10.25"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
