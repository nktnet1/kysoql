{
  "name": "@kysoql/codegen",
  "version": "0.0.0",
  "description": "Schema generation CLI for kysoql",
  "license": "MIT",
  "keywords": [
    "builder",
    "cli",
    "codegen",
    "kysely",
    "query",
    "query builder",
    "salesforce",
    "schema",
    "soql",
    "sql",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test",
    "typecheck:source": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "node --experimental-strip-types ../../scripts/release/prevent-direct-publish.ts"
  },
  "bin": {
    "kysoql": "./dist/cli.mjs"
  },
  "oclif": {
    "bin": "kysoql",
    "dirname": "kysoql",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands.mjs",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " "
  },
  "dependencies": {
    "@kysoql/auth": "workspace:*",
    "@kysoql/rest": "workspace:*",
    "@oclif/core": "5.0.1",
    "jiti": "2.7.0",
    "valibot": "1.5.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nktnet1/kysoql.git",
    "directory": "packages/codegen"
  },
  "bugs": {
    "url": "https://github.com/nktnet1/kysoql/issues"
  },
  "homepage": "https://github.com/nktnet1/kysoql#readme"
}
