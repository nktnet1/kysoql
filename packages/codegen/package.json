{
  "name": "@kysoql/codegen",
  "version": "0.0.0",
  "description": "Schema generation CLI for kysoql",
  "keywords": [
    "salesforce",
    "soql",
    "typescript",
    "schema",
    "codegen",
    "cli"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test",
    "typecheck:source": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "bin": {
    "kysoql": "./dist/cli.mjs"
  },
  "oclif": {
    "bin": "kysoql",
    "dirname": "kysoql",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands.mjs",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " "
  },
  "dependencies": {
    "@oclif/core": "4.14.0",
    "jsforce": "3.10.25",
    "valibot": "1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
