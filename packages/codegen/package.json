{
  "name": "@kysoql/codegen",
  "version": "0.0.0",
  "description": "Schema generation CLI for kysoql",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "workspace:*",
    "typescript": "workspace:*",
    "vitest": "workspace:*"
  },
  "bin": {
    "kysoql": "./dist/cli.js"
  },
  "dependencies": {
    "jsforce": "^3.10.9"
  }
}
