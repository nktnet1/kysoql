{
  "name": "@kysoql/core",
  "version": "0.0.0",
  "description": "Type-safe SOQL query builder and compiler",
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "valibot": "1.4.2"
  }
}
