{
  "name": "@kysoql/core",
  "version": "0.0.0",
  "description": "Type-safe SOQL query builder and compiler",
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "valibot": "1.4.2"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
