{
  "name": "@kysoql/core",
  "version": "0.0.0",
  "description": "Kysely-inspired, type-safe Salesforce SOQL query builder and compiler",
  "license": "MIT",
  "keywords": [
    "salesforce",
    "soql",
    "typescript",
    "query-builder",
    "type-safe"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test",
    "typecheck:source": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nktnet1/kysoql.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nktnet1/kysoql/issues"
  },
  "homepage": "https://github.com/nktnet1/kysoql#readme"
}
