{
  "name": "@kysoql/rest",
  "version": "0.1.0-beta.1",
  "description": "Native Salesforce REST query executor for kysoql",
  "license": "MIT",
  "keywords": [
    "builder",
    "kysely",
    "query",
    "query builder",
    "rest",
    "salesforce",
    "soql",
    "sql",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "biome check",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test",
    "typecheck:source": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "node --experimental-strip-types ../../scripts/release/prevent-direct-publish.ts"
  },
  "dependencies": {
    "@kysoql/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nktnet1/kysoql.git",
    "directory": "packages/rest"
  },
  "bugs": {
    "url": "https://github.com/nktnet1/kysoql/issues"
  },
  "homepage": "https://github.com/nktnet1/kysoql#readme"
}
