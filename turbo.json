{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["KYSOQL_TARGET_ORG"],
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "typecheck:source": {
      "dependsOn": ["^typecheck:source", "^build"]
    },
    "typecheck:test": {
      "dependsOn": ["^typecheck:test", "^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
