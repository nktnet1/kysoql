{
  "name": "kysoql",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check --",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:conformance": "vitest run packages/core/tests/semantic-conformance.test.ts",
    "test:packed-consumer": "pnpm build && pnpm verify:packed-consumer",
    "test:tasks": "vitest run scripts/typecheck-tasks.test.ts",
    "t": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test",
    "typecheck:source": "pnpm test:tasks && tsc -p tsconfig.scripts.json && turbo run typecheck:source",
    "typecheck:test": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p test/tsconfig.json && turbo run typecheck:test",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "release:check": "pnpm validate && pnpm verify:release:publish && pnpm verify:packed-consumer",
    "clean": "turbo run clean && rm -rf node_modules",
    "salesforce:setup": "node --experimental-strip-types scripts/setup-salesforce-test-org.ts",
    "salesforce:apex-binds": "node --experimental-strip-types scripts/run-salesforce-apex-bind-smoke.ts",
    "salesforce:aggregate-offset": "node --experimental-strip-types scripts/run-salesforce-aggregate-offset-smoke.ts",
    "salesforce:big-object": "node --experimental-strip-types scripts/run-salesforce-big-object-smoke.ts",
    "salesforce:e2e": "node --experimental-strip-types scripts/run-salesforce-generated-e2e.ts",
    "salesforce:schema": "node --experimental-strip-types scripts/generate-salesforce-schema.ts",
    "verify:publish": "node --experimental-strip-types scripts/verify-publish-shape.ts",
    "verify:packed-consumer": "node --experimental-strip-types scripts/verify-packed-consumer.ts",
    "verify:release": "node --experimental-strip-types scripts/verify-release-metadata.ts",
    "verify:release:publish": "node --experimental-strip-types scripts/verify-release-metadata.ts --publish-ready",
    "ci": "node --experimental-strip-types scripts/ci.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@oclif/core": "5.0.1",
    "@salesforce/cli": "^2.151.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "lefthook": "2.1.14",
    "tsdown": "0.23.0",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nktnet1/kysoql.git"
  },
  "bugs": {
    "url": "https://github.com/nktnet1/kysoql/issues"
  },
  "homepage": "https://github.com/nktnet1/kysoql#readme"
}
