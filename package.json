{
  "name": "kysoql",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check --",
    "test": "vitest run",
    "t": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.scripts.json && turbo run typecheck",
    "validate": "bash scripts/validate.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "salesforce:setup": "bash scripts/setup-salesforce-test-org.sh",
    "salesforce:apex-binds": "bash scripts/run-salesforce-apex-bind-smoke.sh",
    "salesforce:schema": "bash scripts/generate-salesforce-schema.sh",
    "debug": "pnpm --filter @kysoql/core build && pnpm --filter @kysoql/debug debug",
    "verify:publish": "node scripts/verify-publish-shape.ts",
    "verify:release": "node scripts/verify-release-metadata.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@salesforce/cli": "^2.150.6",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "lefthook": "2.1.14",
    "tsdown": "0.23.0",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
