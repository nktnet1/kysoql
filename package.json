{
  "name": "kysoql",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check --",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:tasks": "node --test scripts/typecheck-tasks.test.mjs",
    "t": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm typecheck:source && pnpm typecheck:test",
    "typecheck:source": "pnpm test:tasks && tsc -p tsconfig.scripts.json && turbo run typecheck:source",
    "typecheck:test": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p test/tsconfig.json && turbo run typecheck:test",
    "validate": "bash scripts/validate.sh",
    "clean": "turbo run clean && rm -rf node_modules",
    "salesforce:setup": "bash scripts/setup-salesforce-test-org.sh",
    "salesforce:apex-binds": "bash scripts/run-salesforce-apex-bind-smoke.sh",
    "salesforce:aggregate-offset": "bash scripts/run-salesforce-aggregate-offset-smoke.sh",
    "salesforce:e2e": "bash scripts/run-salesforce-generated-e2e.sh",
    "salesforce:schema": "bash scripts/generate-salesforce-schema.sh",
    "verify:publish": "node scripts/verify-publish-shape.ts",
    "verify:release": "node scripts/verify-release-metadata.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@salesforce/cli": "^2.150.6",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "lefthook": "2.1.14",
    "tsdown": "0.23.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vitest": "5.0.1"
  }
}
